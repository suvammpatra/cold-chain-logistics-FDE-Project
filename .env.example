# Copy to .env and fill in the passwords. Never commit .env.

# Which SQL Server the scripts use when --target is not passed: local | aws
DB_TARGET=local

# Where the agent audit trail is written and read (only that server's admin can view it): aws | local
AUDIT_DB_TARGET=aws

# --- LOCAL: Docker container `legacy-mssql` on this PC -----------------------
LOCAL_SQL_HOST=127.0.0.1
LOCAL_SQL_PORT=1433
LOCAL_SQL_DATABASE=master
LOCAL_SQL_USER=sa
LOCAL_SQL_PASSWORD="<local-sa-password>"

# --- AWS: SQL Server on EC2, reached ONLY through the SSH tunnel -------------
#   ssh -i "$AWS_SSH_KEY_PATH" -N -L 14330:127.0.0.1:1433 ubuntu@$AWS_EC2_HOST
AWS_SQL_HOST=127.0.0.1
AWS_SQL_PORT=14330
AWS_SQL_DATABASE=SupplyChainDB
AWS_SQL_USER=sa
AWS_SQL_PASSWORD="<aws-sa-password>"

# EC2 SSH details (used for the tunnel hint only)
AWS_EC2_HOST=<ec2-public-ip>
AWS_SSH_KEY_PATH=<path-to-key.pem>

# Optional: override the ODBC driver name
# SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
